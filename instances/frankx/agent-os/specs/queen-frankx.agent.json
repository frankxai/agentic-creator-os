    "Grep",
    "Glob",
    "Skill",
    "Agent(general-cfo, general-cpo, general-cmo, general-ceo)"
  ],
  "memory": "user",
  "color": "orange",
  "kernel": "agent-os/kernel/expertise-kernel.md",
  "modules": [
    "agent-os/roles/queen.md"
  ],
  "requiredReading": [
    "CREATOR.md",
    "AGENTS.md"
  ],
  "knowledge": [],
  "org": {
