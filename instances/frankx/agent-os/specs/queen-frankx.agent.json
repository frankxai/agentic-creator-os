          "checkout-integrity",
          "funnel-economics"
        ]
      },
      {
        "title": "Product General",
        "sourceId": "FRANKX-PRODUCT-GENERAL",
        "role": "cpo",
        "agent": "general-cpo",
        "swarms": [
          "product-architect",
          "packaging",
          "pricing"
        ]
      },
      {
