{
  "name": "@agentic-creator-os/creator-mcp",
  "version": "1.0.0",
  "description": "Creator business tools MCP server for Agentic Creator OS",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts src/social/producer.ts --bundle --outdir=build --outbase=src --format=esm --platform=node --target=node20 --packages=external",
    "build:fast": "esbuild src/index.ts src/social/producer.ts --bundle --outdir=build --outbase=src --format=esm --platform=node --target=node20",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit",
    "dev": "tsc -w",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}
