{
  "name": "@frankx/agentic-creator-os",
  "version": "11.0.0",
  "description": "Reusable skills, commands, agent profiles, hooks, and platform adapters for AI-assisted creative work.",
  "author": "Frank Riemer <frank@frankx.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/agentic-creator-os"
  },
  "homepage": "https://frankx.ai/products/agentic-creator-os",
  "bugs": {
    "url": "https://github.com/frankxai/agentic-creator-os/issues"
  },
  "keywords": [
    "claude-code",
    "grok",
    "grok-cli",
    "grok-build",
    "xai",
    "cursor",
    "windsurf",
    "gemini",
    "antigravity",
    "ai-agent",
    "creator-tools",
    "mcp",
    "anthropic",
    "skills",
    "workflows",
    "content-creation",
    "agentic-ai",
    "sip",
    "starlight-intelligence"
  ],
  "bin": {
    "acos": "./bin/acos-sync.sh",
    "acos-sync": "./bin/acos-sync.sh",
    "acos-enhance": "./bin/acos-enhance"
  },
  "files": [
    "bin/",
    "departments/",
    "instances/",
    "mcp-servers/",
    "skills/",
    "templates/",
    "workflows/",
    "docs/",
    "tools/observatory/",
    "scripts/build-catalog.mjs",
    "scripts/build-catalog.test.mjs",
    "install.sh",
    "CLAUDE.md",
    "CREATOR_NEEDS.md",
    "README.md"
  ],
  "workspaces": [
    "mcp-servers/*"
  ],
  "scripts": {
    "observatory": "node tools/observatory/server.mjs",
    "observatory:catalog": "node scripts/build-catalog.mjs",
    "observatory:install-hooks": "node tools/observatory/install-hooks.mjs",
    "observatory:test": "node --test scripts/build-catalog.test.mjs",
    "verify:public-surface": "node scripts/verify-public-surface.mjs",
    "test:receipt": "node --test tools/receipt-check/check-receipt.test.mjs",
    "install:all": "npm install --workspaces",
    "build:all": "npm run build --workspaces",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "dev:all": "npm run dev --workspaces",
    "postinstall": "echo '\\n🚀 Agentic Creator OS installed! Run: ./install.sh\\n'",
    "publish": "npm run build:all && npm publish",
    "version:bump": "npm version $npm_config_version && git push && git push --tags",
    "lint": "node scripts/lint.mjs",
    "agents:compile": "node scripts/agent-compile.mjs && node scripts/agent-compile.mjs --instance frankx",
    "agents:check": "node scripts/agent-compile.mjs --check && node scripts/agent-compile.mjs --check --instance frankx && node scripts/org-import.mjs --org instances/frankx/agent-os/org/domain-queens.json --instance frankx --check && node scripts/agent-os-graph.mjs --instance frankx",
    "agents:org": "node scripts/org-import.mjs --org instances/frankx/agent-os/org/domain-queens.json --instance frankx && node scripts/agent-compile.mjs --instance frankx",
    "mesh:doctor": "node scripts/mesh-doctor.mjs --mesh",
    "mesh:dispatch": "node scripts/mesh-dispatch.mjs",
    "always-on": "node scripts/always-on-status.mjs --mesh",
    "agents:init": "node scripts/agent-os-init.mjs --name",
    "upstreams:watch": "node scripts/upstream-watch.mjs",
    "estate:audit": "node scripts/estate-audit.mjs",
    "test": "npm run build:all && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "overrides": {
    "typescript": "5.6.3",
    "fast-uri": "^3.1.6",
    "hono": "^4.12.25",
    "ip-address": "^10.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
